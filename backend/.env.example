APP_ENV=development
DATABASE_URL=
AI_PROVIDER=
AI_API_KEY=
# ID público de Google Cloud OAuth 2.0, tipo Aplicación web.
GOOGLE_OAUTH_CLIENT_ID=

# Acceso por código enviado al correo (desactivado hasta configurar SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_OTP_PEPPER=

# Microsoft Entra (Aplicación web, OAuth 2.0 + PKCE)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://my-teacher-ia-api.onrender.com/api/conauti/auth/microsoft/callback

# Opción gratuita preferida para Render Free: Mailjet API HTTPS
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
# SMTP solo en entornos donde se permitan conexiones al puerto 587
EMAIL_OTP_SMTP_ENABLED=false

# Mejoras opcionales del tutor (por defecto sin costes adicionales)
# El almacenamiento de checkpoints replica estado educativo en PostgreSQL.
LANGGRAPH_CHECKPOINTS_ENABLED=false
# Solo activar tras revisar la cuota de Gemini Embeddings.
RAG_EMBEDDINGS_ENABLED=false
# Modelo alternativo opcional ante fallos 5xx; nunca ante límites 429.
GEMINI_FALLBACK_MODEL=

# Opciones del tutor multiagente con Qwen3 de pesos abiertos.
# Local: AI_PROVIDER=ollama, OLLAMA_ENABLED=true y Qwen3 instalado en el servidor.
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen3:4b
# Nube: AI_PROVIDER=openrouter y una clave privada configurada fuera del repositorio.
# La aplicación acepta solo el identificador gratuito de Qwen3 indicado aquí.
OPENROUTER_MODEL=qwen/qwen3-4b:free
OPENROUTER_API_KEY=

# Modelos abiertos para visión y voz en el tutor multiagente.
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-235b-a22b-thinking:free
OPEN_ASR_ENABLED=true
OPEN_WHISPER_MODEL=base
