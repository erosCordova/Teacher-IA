APP_ENV=development
DATABASE_URL=
AI_PROVIDER=
AI_API_KEY=
# ID público de Google Cloud OAuth 2.0, tipo Aplicación web.
GOOGLE_OAUTH_CLIENT_ID=

# Acceso por código enviado al correo (desactivado hasta configurar SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_OTP_PEPPER=

# Microsoft Entra (Aplicación web, OAuth 2.0 + PKCE)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://my-teacher-ia-api.onrender.com/api/conauti/auth/microsoft/callback

# Opción gratuita preferida para Render Free: Mailjet API HTTPS
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
# SMTP solo en entornos donde se permitan conexiones al puerto 587
EMAIL_OTP_SMTP_ENABLED=false

# Mejoras opcionales del tutor (por defecto sin costes adicionales)
# El almacenamiento de checkpoints replica estado educativo en PostgreSQL.
LANGGRAPH_CHECKPOINTS_ENABLED=false
# Solo activar tras revisar la cuota de Gemini Embeddings.
RAG_EMBEDDINGS_ENABLED=false
# Modelo alternativo opcional ante fallos 5xx; nunca ante límites 429.
GEMINI_FALLBACK_MODEL=

# Proveedor local opcional. Render sigue usando Gemini, nunca Ollama.
OLLAMA_ENABLED=false
OLLAMA_MODEL=gemma3:1b
# Para probar localmente: AI_PROVIDER=ollama y OLLAMA_ENABLED=true.
